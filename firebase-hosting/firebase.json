{
  "hosting": {
    "target": "kitlinks",
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      {
        "source": "/kit/**",
        "destination": "/kit/index.html"
      },
      {
        "source": "/track/**",
        "destination": "/track/index.html"
      },
      {
        "source": "/certificates/**",
        "destination": "/certificates/index.html"
      }
    ]
  }
}
